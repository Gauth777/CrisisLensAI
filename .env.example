CRISISLENS_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Free-plan option: create a key at https://console.groq.com/keys
# Set CRISISLENS_PROVIDER=groq to select it by default in the frontend.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Official alerts and field reports work without an LLM key.
# Optional: choose a private, long random token to enable coordinator review.
# Leave empty to disable review. Never put this value in frontend configuration.
CRISISLENS_REVIEW_TOKEN=
# SQLite records persist across restarts; keep this directory private.
CRISISLENS_DB_PATH=runtime/operations.sqlite3
# Background SACHET polling (120 seconds between completed checks).
CRISISLENS_ALERT_POLLING=1
